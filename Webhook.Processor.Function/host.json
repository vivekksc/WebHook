{
  "version": "2.0",
  "extensions": {
    "serviceBus": {
      "sessionHandlerOptions": {
        "autoComplete": true,
        "maxConcurrentSessions": 20
      },
      "clientRetryOptions": {
        "mode": "exponential",
        "delay": "00:00:03",
        "maximumDelay": "00:01:00",
        "maximumRetries": 3
      }
    }
  },
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    }
  }
}